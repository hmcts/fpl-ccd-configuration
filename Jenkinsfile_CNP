static Map<String, Object> secret(String secretName, String envVariable) {
  [
    $class     : 'AzureKeyVaultSecret',
    secretType : 'Secret',
    name       : secretName,
    envVariable: envVariable
  ]
}

def archiveCoreCaseDataDefinitions(env) {
  dir("${WORKSPACE}/bin") {
    if ("preview" == env) {
      sh "./build-preview-ccd-definitions.sh ${CHANGE_ID}"
    } else {
      sh "./build-release-ccd-definition.sh ${env}"
      sh "./build-shuttered-ccd-definition.sh ${env}"
    }
  }

  dir("${WORKSPACE}/build") {
    if ("preview" == env) {
      steps.archiveArtifacts artifacts: "ccd-release-config/ccd-fpl-preview-${CHANGE_ID}-toggle-on.xlsx"
      steps.archiveArtifacts artifacts: "ccd-release-config/ccd-fpl-preview-${CHANGE_ID}-toggle-off.xlsx"
      steps.archiveArtifacts artifacts: "ccd-release-config/ccd-fpl-preview-${CHANGE_ID}-shuttered.xlsx"
    } else {
      steps.archiveArtifacts artifacts: "ccd-release-config/ccd-fpl-${env}.xlsx"
      steps.archiveArtifacts artifacts: "ccd-release-config/ccd-fpl-${env}-shuttered.xlsx"
    }
  }
}

/**
 * Imports CCD definitions into specified environment. Import XLSX file is archived when process completed.
 *
 * NOTE: It requires `bin/variables/load-${env}-environment-variables.sh` file to define environment specific URLs.
 *
 * @param env target environment
 */
def uploadCoreCaseDataDefinitions(env, useShutteredCaseDef) {
  dir("${WORKSPACE}/bin"){
    if("preview" == env){
      ccdDefinitionFilePath = "${WORKSPACE}/build/ccd-release-config/ccd-fpl-preview-${CHANGE_ID}-toggle-on.xlsx"
      sh """
        eval \$(./variables/load-preview-environment-variables.sh ${CHANGE_ID})
        ./ccd-import-definition.sh ${ccdDefinitionFilePath}
      """
    } else {
      ccdDefinitionFilePath = useShutteredCaseDef == '1'
        ? "${WORKSPACE}/build/ccd-release-config/ccd-fpl-${env}-shuttered.xlsx"
        : "${WORKSPACE}/build/ccd-release-config/ccd-fpl-${env}.xlsx"

      sh """
        eval \$(./variables/load-${env}-environment-variables.sh)
        ./ccd-import-definition.sh ${ccdDefinitionFilePath}
      """
    }
  }
}

def setupSecretsForIntegrationTests() {
  withSubscription('nonprod') {
    def integrationTestPipelineConf = new AppPipelineConfig()
    integrationTestPipelineConf.vaultSecrets = integrationTestSecrets()

    def integrationTestNotifyServiceKey
    def integrationTestDocmosisTornadoKey
    def e2eTestPassword
    def systemUpdateUserUsername
    def systemUpdateUserPassword
    def e2eTestJudgePassword
    def idamClientSecret

    withTeamSecrets(integrationTestPipelineConf, 'aat') {
      integrationTestNotifyServiceKey = "${INTEGRATION_TEST_NOTIFY_SERVICE_KEY}"
      integrationTestDocmosisTornadoKey = "${INTEGRATION_TEST_DOCMOSIS_TORNADO_KEY}"
      e2eTestPassword = "${E2E_TEST_PASSWORD}"
      systemUpdateUserUsername = "${SYSTEM_UPDATE_USER_USERNAME}"
      systemUpdateUserPassword = "${SYSTEM_UPDATE_USER_PASSWORD}"
      e2eTestJudgePassword = "${E2E_TEST_JUDGE_PASSWORD}"
      idamClientSecret = "${IDAM_CLIENT_SECRET}"
    }

    /* Setup integration secrets for later stage steps outside withTeamSecrets. */
    env.INTEGRATION_TEST_NOTIFY_SERVICE_KEY = integrationTestNotifyServiceKey
    env.INTEGRATION_TEST_DOCMOSIS_TORNADO_KEY = integrationTestDocmosisTornadoKey
    env.E2E_TEST_PASSWORD = e2eTestPassword
    env.SYSTEM_UPDATE_USER_USERNAME = systemUpdateUserUsername
    env.SYSTEM_UPDATE_USER_PASSWORD = systemUpdateUserPassword
    env.E2E_TEST_JUDGE_PASSWORD = e2eTestJudgePassword
    env.IDAM_CLIENT_SECRET = idamClientSecret
    env.INTEGRATION_TEST_DOCMOSIS_TORNADO_URL = "https://docmosis.aat.platform.hmcts.net"
    env.INTEGRATION_TEST_DOCMOSIS_TORNADO_OUTPUT_FOLDER = "${WORKSPACE}/build/docmosis-generated"
  }
}

def runPreviewUiFunctionalTests() {
  withSubscription('nonprod') {
    def uiFunctionalPipelineConf = new AppPipelineConfig()
    def uiFunctionalYarnBuilder = new YarnBuilder(this)
    uiFunctionalPipelineConf.vaultSecrets = integrationTestSecrets()

    withTeamSecrets(uiFunctionalPipelineConf, 'aat') {
      setupUITestEnvVariablesForPreview()
      uiFunctionalYarnBuilder.yarn('test:functional-nightly-preview')
    }
  }
}

def runPreviewSmokeTests() {
  withSubscription('nonprod') {
    def smokeTestPipelineConf = new AppPipelineConfig()
    def smokeYarnBuilder = new YarnBuilder(this)
    smokeTestPipelineConf.vaultSecrets = integrationTestSecrets()

    withTeamSecrets(smokeTestPipelineConf, 'aat') {
      setupUITestEnvVariablesForPreview()
      smokeYarnBuilder.yarn('test:smoke')
    }
  }
}

def runPreviewRoleSetup(boolean waEnabled) {
  withSubscription('nonprod') {
    def roleAssignmentPipelineConf = new AppPipelineConfig()
    roleAssignmentPipelineConf.vaultSecrets = roleAssignmentSecrets()

    withTeamSecrets(roleAssignmentPipelineConf, 'aat') {
      if (waEnabled) {
        sh """
          set -eu
          eval \$(./bin/variables/load-preview-environment-variables.sh ${CHANGE_ID})
          ./bin/add-ccd-user-roles.sh
          ./bin/add-role-assignments.sh --skip-system-update-am-role-seeding
          bash ./bin/wait-for-system-update-am-role.sh 18 10
        """
      } else {
        echo "Skipping system-update AM role wait because 'pr-values:wa' label is not present"
        sh """
          set -eu
          eval \$(./bin/variables/load-preview-environment-variables.sh ${CHANGE_ID})
          ./bin/add-ccd-user-roles.sh
          ./bin/add-role-assignments.sh --skip-system-update-am-role-seeding
        """
      }
    }
  }
}

